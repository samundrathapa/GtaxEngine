# =========================================================================
# gtax Enterprise - Database Connection Configuration (PostgreSQL)
# All parameters are dynamic. You can change DB_NAME to any database (e.g. gtax_dbtest).
# If you run npm run dev or run_migrations.bat, the system will dynamically
# connect to the database specified in DB_NAME.
# =========================================================================
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="gtax_db"
DB_USER="gtax_user"
DB_PASSWORD="gtax_password"
DB_SSL="false"

# Optional: Full connection URL.
# If DATABASE_URL is uncommented, any explicit DB_* variables above (such as DB_NAME=gtax_dbtest)
# will dynamically override the corresponding component in DATABASE_URL.
# DATABASE_URL="postgresql://gtax_user:gtax_password@localhost:5432/gtax_db"

# =========================================================================
# AI Studio & Runtime Configuration
# =========================================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
